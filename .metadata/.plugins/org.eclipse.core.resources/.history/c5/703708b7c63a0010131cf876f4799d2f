/* USER CODE BEGIN PV */
extern PDM_Filter_Handler_t PDM1_filter_handler;
extern PDM_Filter_Config_t PDM1_filter_config;

// Buffers Ping-Pong para la entrada PDM (cada mitad tiene para un frame FFT)
uint16_t pdm_raw_buffer[2][PDM_RAW_INPUT_FFT_FRAME_SIZE_UINT16];
// Buffer para la salida PCM MONO del filtro PDM (un frame FFT)
int16_t  pcm_mono_fft_input_buffer[PCM_MONO_SAMPLES_PER_FFT_FRAME];
// Buffer de salida al CODEC (si el loopback sigue activo)
uint16_t pcm_stereo_output_buffer[2][PCM_STEREO_OUTPUT_HALF_BUFFER_SIZE_UINT16];

volatile uint8_t pdm_input_buffer_idx = 2; // 0: primera mitad PDM lista, 1: segunda, 2: ninguna
volatile uint8_t pcm_output_buffer_ready_for_filling_idx = 0; // Para loopback al CODEC

// Buffers y Handles para FFT
float32_t fft_input_f32[FFT_SIZE];
float32_t fft_output_f32[FFT_SIZE]; // Salida empaquetada de RFFT
// float32_t fft_magnitudes[FFT_SIZE / 2]; // No es necesario si calculamos dB directamente

arm_rfft_fast_instance_f32 fft_instance; // Handle para la instancia de RFFT float32

// Buffer para transmisión UART
char uart_tx_buffer[UART_BUFFER_SIZE];

// Ventana Hann (opcional pero recomendado)
float32_t hann_window[FFT_SIZE];
/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
void PeriphCommonClock_Config(void);
