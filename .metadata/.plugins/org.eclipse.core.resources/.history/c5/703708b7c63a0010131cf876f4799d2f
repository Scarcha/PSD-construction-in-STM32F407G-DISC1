/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
void init_hann_window(void) {
    for (int i = 0; i < FFT_SIZE; i++) {
        hann_window[i] = 0.5f * (1.0f - arm_cos_f32(2.0f * PI * i / (FFT_SIZE - 1.0f)));
    }
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
	  uint8_t initial_codec_volume = 60; // Ajusta el volumen (0-100)
	  uint16_t pdm_buffer_offset_uint16 = 0;
	  uint16_t pcm_mono_buffer_offset = 0;

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* Configure the peripherals common clocks */
  PeriphCommonClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_I2S2_Init();
  MX_CRC_Init();
  MX_PDM2PCM_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();
  MX_SPI1_Init();
  MX_I2S3_Init();
  /* USER CODE BEGIN 2 */
  init_hann_window();
  // Inicializar y configurar CS43L22
    if (cs43l22_Init(CS43L22_ADDRESS, OUTPUT_DEVICE_HEADPHONE, initial_codec_volume, PCM_SAMPLING_FREQ) != 0) {
        Error_Handler();
    }
    if (cs43l22_Play(CS43L22_ADDRESS, NULL, 0) != 0) { // pBuffer y Size no se usan por el driver para iniciar
        Error_Handler();
    }
    printf("CS43L22 Inicializado y Play activado.\r\n");

    // Inicializar instancia FFT
    if (arm_rfft_fast_init_f32(&fft_instance, FFT_SIZE) != ARM_MATH_SUCCESS) {
        Error_Handler();
    }

    // Llenar buffer de salida CODEC con silencio e iniciar DMA I2S3
    memset(pcm_stereo_output_buffer, 0, sizeof(pcm_stereo_output_buffer));
    if (HAL_I2S_Transmit_DMA(&hi2s3, (uint16_t *)pcm_stereo_output_buffer, PCM_STEREO_OUTPUT_HALF_BUFFER_SIZE_UINT16 * 2) != HAL_OK) {
      Error_Handler();
    }

    // Iniciar DMA I2S2 para PDM
    if (HAL_I2S_Receive_DMA(&hi2s2, (uint16_t *)pdm_raw_buffer, PDM_RAW_INPUT_FFT_FRAME_SIZE_UINT16 * 2) != HAL_OK) {
      Error_Handler();
    }
    pdm_input_buffer_idx = 2; // Ningún buffer PDM listo
    pcm_output_buffer_ready_for_filling_idx = 0; // Primera mitad del buffer de loopback lista para llenarse

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  if (pdm_input_buffer_idx != 2) { // Un buffer PDM (un frame FFT) está listo
	        uint16_t* current_pdm_input_half_ptr;
	        // uint16_t* current_pcm_stereo_output_half_ptr; // Para loopback

	        if (pdm_input_buffer_idx == 0) {
	          current_pdm_input_half_ptr = pdm_raw_buffer[0];
	        } else { // pdm_input_buffer_idx == 1
	          current_pdm_input_half_ptr = pdm_raw_buffer[1];
	        }

	        // 1. Convertir el frame PDM completo a PCM MONO en pcm_mono_fft_input_buffer
	        pdm_buffer_offset_uint16 = 0;
	        pcm_mono_buffer_offset = 0;
	        for (int i = 0; i < NUM_PDM_PROCESS_CALLS_PER_FFT_FRAME; i++) {
	          if (MX_PDM2PCM_Process(
	                  current_pdm_input_half_ptr + pdm_buffer_offset_uint16,
	                  (uint16_t*)(pcm_mono_fft_input_buffer + pcm_mono_buffer_offset)
	               ) != 0) {
	              printf("Error en MX_PDM2PCM_Process\r\n");
	              // Podrías querer saltar este frame FFT
	          }
	          pdm_buffer_offset_uint16 += (PDM_BYTES_PER_PROCESS_CALL / 2U);
	          pcm_mono_buffer_offset += PDM_SAMPLES_PER_PDM_LIB_CALL;
	        }

	        // 2. Preparar datos para FFT: Convertir int16_t PCM a float32_t y aplicar ventana
	        for (int i = 0; i < FFT_SIZE; i++) {
	            // Normalizar a [-1.0, 1.0] es bueno para dBFS, pero opcional
	            // fft_input_f32[i] = ((float32_t)pcm_mono_fft_input_buffer[i] / 32768.0f) * hann_window[i];
	            fft_input_f32[i] = (float32_t)pcm_mono_fft_input_buffer[i] * hann_window[i]; // Aplicar ventana
	        }

	        // 3. Calcular RFFT
	        arm_rfft_fast_f32(&fft_instance, fft_input_f32, fft_output_f32, 0);

	        // 4. Enviar Magnitudes FFT en dB por UART
	        int uart_len = 0;
	        float32_t mag_val, db_val;

	        // Enviar SOF
	        uart_len = sprintf(uart_tx_buffer, "SOF\r\n");
	        HAL_UART_Transmit(&huart2, (uint8_t*)uart_tx_buffer, uart_len, HAL_MAX_DELAY);
	        uart_len = 0;

	        // Bin 0 (DC)
	        mag_val = fabsf(fft_output_f32[0]);
	        // Si normalizaste la entrada y quieres dBFS: mag_val /= (FFT_SIZE / 2.0f); (aplica solo a DC si se maneja diferente)
	        // O una normalización más simple es dividir todas las magnitudes por FFT_SIZE después de sqrt.
	        // Por ahora, dB relativos a las magnitudes crudas de la FFT escaladas por la ventana:
	        if (mag_val < EPSILON) { db_val = DB_FLOOR; }
	        else { db_val = 20.0f * log10f(mag_val); if (db_val < DB_FLOOR) { db_val = DB_FLOOR; } }
	        uart_len += sprintf(uart_tx_buffer + uart_len, "%.2f\r\n", db_val);

	        // Bins 1 a (FFT_SIZE / 2) - 1
	        for (int k = 1; k < FFT_SIZE / 2; k++) {
	            float32_t real_part = fft_output_f32[2*k];
	            float32_t imag_part = fft_output_f32[2*k+1];
	            arm_sqrt_f32(real_part * real_part + imag_part * imag_part, &mag_val);
	            // Si normalizaste la entrada y quieres dBFS: mag_val /= (FFT_SIZE / 2.0f);
	            // O normalización general: mag_val /= FFT_SIZE; (después de sqrt)

	            if (mag_val < EPSILON) { db_val = DB_FLOOR; }
	            else { db_val = 20.0f * log10f(mag_val); if (db_val < DB_FLOOR) { db_val = DB_FLOOR; } }
	            uart_len += sprintf(uart_tx_buffer + uart_len, "%.2f\r\n", db_val);

	            if (uart_len > (UART_BUFFER_SIZE - 20) || k == (FFT_SIZE / 2) - 1) {
	                if (uart_len > 0) {
	                    HAL_UART_Transmit(&huart2, (uint8_t*)uart_tx_buffer, uart_len, HAL_MAX_DELAY);
	                    uart_len = 0;
	                }
	            }
	        }
	        if (uart_len > 0) { // Enviar cualquier remanente
	            HAL_UART_Transmit(&huart2, (uint8_t*)uart_tx_buffer, uart_len, HAL_MAX_DELAY);
	        }
	        // printf("FFT Frame enviado\r\n"); // Para depuración local si tienes otra UART/SWO

	        // 5. Opcional: Loopback al CODEC (si pcm_output_buffer_ready_for_filling_idx lo permite)
	        if (pcm_output_buffer_ready_for_filling_idx != 2) {
	            uint16_t* current_pcm_stereo_output_half_ptr;
	            if (pcm_output_buffer_ready_for_filling_idx == 0) {
	                current_pcm_stereo_output_half_ptr = pcm_stereo_output_buffer[0];
	            } else { // pcm_output_buffer_ready_for_filling_idx == 1
	                current_pcm_stereo_output_half_ptr = pcm_stereo_output_buffer[1];
	            }

	            for (uint16_t i = 0; i < PCM_MONO_SAMPLES_PER_FFT_FRAME; i++) {
	                current_pcm_stereo_output_half_ptr[i * 2]     = (uint16_t)pcm_mono_fft_input_buffer[i];
	                current_pcm_stereo_output_half_ptr[i * 2 + 1] = (uint16_t)pcm_mono_fft_input_buffer[i];
	            }
	            pcm_output_buffer_ready_for_filling_idx = 2; // Marcar como no listo para llenar
	        }
	        pdm_input_buffer_idx = 2;
	        HAL_Delay(50);
	  } else{
		  HAL_Delay(1);
	  }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

